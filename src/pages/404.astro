---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Página no encontrada · Carballo Tardío" description="Esta página no existe.">
  <section class="wrap" style="padding-top:clamp(64px,10vw,140px);display:grid;gap:20px;max-width:44rem">
    <h1 style="font:italic 300 var(--s5)/1.05 var(--serif)">Aquí no hay nada.</h1>
    <p>La página que buscas no existe o ha cambiado de sitio.</p>
    <p><a class="link" href={`${base}proyectos/`}>Ver proyectos</a> &nbsp; <a class="link" href={base}>Volver al inicio</a></p>
  </section>
</Base>
