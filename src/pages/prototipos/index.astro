---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Prototipos · Carballo Tardío" description="Prototipos de recorrido del archivo." current="proyectos">
  <section class="wrap" style="padding-top:clamp(48px,8vw,110px);display:grid;gap:24px;max-width:56rem">
    <h1 style="font:300 var(--s5)/1.05 var(--serif)">Prototipos</h1>
    <p>El recorrido en columnas se eligió y ya forma parte del archivo. El recorrido horizontal se descartó.</p>
    <p><a class="link" href={`${base}proyectos/columnas/`}>Ver proyectos en columnas</a></p>
  </section>
</Base>
