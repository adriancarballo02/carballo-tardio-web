---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base title="Proyectos · Carballo Tardío" description="Archivo de proyectos de Carballo Tardío: audiovisual, fotografía, dron, cine y cultura." current="proyectos">
  <section class="wrap" style="padding-top:clamp(48px,8vw,110px);display:grid;gap:32px">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap"><h1 style="font:300 var(--s5)/1.05 var(--serif)">Proyectos</h1><p class="meta">Archivo, filtros y miniaturas: fase 4 <span class="prov">en construcción</span></p></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));gap:28px var(--gutter)">
      {all.map((p) => <Tile p={p} />)}
    </div>
  </section>
</Base>
<style>.tile :global(.frame){aspect-ratio:var(--r)}</style>
