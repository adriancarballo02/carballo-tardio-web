---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const sel = all.filter((p) => p.data.destacado).slice(0, 10);
const up = sel.filter((_, i) => i % 2 === 0);
const down = sel.filter((_, i) => i % 2 === 1);
const servicios = [
  ['Producción audiovisual', 'Piezas de principio a fin: idea, rodaje, montaje y entrega.'],
  ['Realización y dirección', 'Dirigir la puesta en escena de campañas, cortos y encargos.'],
  ['Fotografía', 'Sesiones, retrato, documental y fotografía de producto.'],
  ['Dron', 'Imagen aérea para territorio, arquitectura, eventos y cine.'],
  ['Publicidad y marca', 'Campañas y piezas para redes que resuelven un objetivo concreto.'],
  ['Cultura e instituciones', 'Proyectos culturales, patrimonio y comunicación pública.'],
];
const pasos = [
  ['Escuchar', 'Conocer a las personas y lo que hay detrás del encargo.'],
  ['Comprender', 'Investigar el contexto y encontrar qué merece la pena contar.'],
  ['Proponer', 'Caminos e ideas concretas, sin perder de vista el objetivo.'],
  ['Acordar', 'Objetivo, condiciones, presupuesto y plazos, por escrito.'],
  ['Producir', 'Con autonomía y responsabilidad, sin supervisión permanente.'],
  ['Entregar', 'En los formatos que hacen falta y a tiempo.'],
];
---
<Base title="Carballo Tardío · Estudio de creación y producción audiovisual" description="Estudio autoral de creación y producción audiovisual nacido en Peque, La Carballeda (Zamora). Vídeo, fotografía, dron y dirección creativa.">
  <script is:inline>(function(){var m=window.matchMedia;if(m('(min-width: 761px)').matches&&!m('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('hscroll')})();</script>

  <section class="entrada" id="entrada" aria-label="Proyectos seleccionados">
    <div class="stage">
      <div class="horizon" aria-hidden="true"><span class="progress" id="progress"></span></div>
      <div class="track" id="track">
        <div class="row up">
          <div class="intro">
            <h1 class="lede">Una mirada propia para cada historia.</h1>
            <p class="meta">Estudio autoral de creación y producción audiovisual. Peque, La Carballeda (Zamora). <span class="prov">texto provisional</span></p>
          </div>
          {up.map((p, i) => <Tile p={p} eager={i < 3} order={i * 2} />)}
        </div>
        <div class="row down">
          {down.map((p, i) => <Tile p={p} eager={i < 2} order={i * 2 + 1} />)}
          <a class="end link" href={`${base}proyectos/`}>Ver todo el archivo →</a>
        </div>
      </div>
      <p class="hint meta" aria-hidden="true"><span id="count">01</span> / {String(sel.length).padStart(2, '0')} · Baja para recorrer</p>
    </div>
  </section>

  <section class="block wrap grid">
    <div class="block-head"><span class="label">Estudio</span><a class="meta" href={`${base}estudio/`}>Conocer el estudio →</a></div>
    <p class="lede col-a">Carballo Tardío es un estudio de creación y producción audiovisual nacido en Peque, en La Carballeda. <em>No queremos trabajar más despacio. Queremos trabajar con intención.</em></p>
    <div class="col-b text">
      <p>Hacemos piezas propias y encargos para marcas, empresas, instituciones y pequeños negocios. Antes de encender la cámara escuchamos: buscamos qué merece la pena contar y qué lenguaje necesita cada proyecto.</p>
      <p>La autoría no decide quién puede contratarnos. Decide cómo abordamos lo que nos encargan.</p>
    </div>
  </section>

  <section class="block wrap grid">
    <div class="block-head"><span class="label">Servicios <span class="prov">por cerrar</span></span><a class="meta" href={`${base}servicios/`}>Todos los servicios →</a></div>
    <ol class="services">
      {servicios.map(([t, d], i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><a href={`${base}servicios/`}>{t}</a><span class="d">{d}</span></li>)}
    </ol>
  </section>

  <section class="block wrap grid">
    <div class="block-head"><span class="label">Cómo trabajamos</span></div>
    <ol class="steps">
      {pasos.map(([t, d], i) => <li><span class="n">{i + 1}</span><b>{t}</b><span>{d}</span></li>)}
    </ol>
  </section>

  <section class="block wrap grid">
    <div class="block-head"><span class="label">Quién está detrás</span></div>
    <div class="portrait"><span class="prov">Retrato pendiente</span></div>
    <div class="who">
      <p class="lede">Adrián Lozano Mateos</p>
      <p class="label">Fundador y director creativo</p>
      <p>Cineasta, guionista y escritor. Viene del cine, la escritura y los departamentos de cámara, y dirige sus propios cortometrajes. Carballo Tardío trabaja con colaboradores y forma el equipo que necesita cada proyecto. <span class="prov">texto provisional</span></p>
    </div>
  </section>

  <section class="block wrap grid">
    <div class="block-head"><span class="label">Contacto</span></div>
    <a class="contact-big" href={`${base}contacto/`}>Cuéntanos qué quieres contar.</a>
  </section>
</Base>

<style>
  /* —— entrada: el archivo abierto —— */
  .entrada{position:relative}
  .stage{position:relative}
  .horizon{display:none}
  .intro{display:grid;gap:14px;align-content:start;max-width:30rem}
  .intro .lede{font-size:var(--s4)}
  .hint{display:none}
  .track{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px var(--gutter);align-items:start;padding:0 max(var(--margin),env(safe-area-inset-left,0px))}
  .row{display:contents}
  .row :global(.tile){order:var(--o)}
  .row .intro{grid-column:1/-1;margin:24px 0 16px;order:-1}
  .row :global(.tile[data-peso="3"]){grid-column:1/-1}
  .row :global(.frame){aspect-ratio:var(--r)}
  .end{grid-column:1/-1;justify-self:start;margin-top:12px;order:999}

  :global(html.hscroll) .stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
  :global(html.hscroll) .horizon{display:block;position:absolute;left:0;right:0;top:54%;border-top:1px solid var(--coal);z-index:1}
  :global(html.hscroll) .progress{position:absolute;left:0;top:-2px;height:3px;width:100%;background:var(--chestnut);transform-origin:left;transform:scaleX(0)}
  :global(html.hscroll) .track{display:block;padding:0;position:absolute;inset:0;will-change:transform}
  :global(html.hscroll) .row{position:absolute;left:0;display:flex;gap:clamp(28px,4vw,64px);padding:0 0 0 max(var(--margin),env(safe-area-inset-left,0px));;padding-right:max(var(--margin),6vw);width:max-content}
  :global(html.hscroll) .row.up{bottom:47.5%;align-items:flex-end}
  :global(html.hscroll) .row.down{top:57%;align-items:flex-start;margin:0;padding-left:calc(max(var(--margin),env(safe-area-inset-left,0px)) + 34rem)}
  :global(html.hscroll) .row .intro{margin:0 4vw 0 0;width:30rem;align-self:flex-end;padding-bottom:6px}
  :global(html.hscroll) .row :global(.tile){width:calc(var(--h) * var(--rn) * 1svh)}
  :global(html.hscroll) .row :global(.frame){height:calc(var(--h) * 1svh);width:100%}
  :global(html.hscroll) .row :global(.tile){flex:none}
  :global(html.hscroll) .row :global(.cap b){white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  :global(html.hscroll) .end{align-self:center;margin:0 max(var(--margin),8vw) 0 2vw;white-space:nowrap}
  :global(html.hscroll) .hint{display:block;position:absolute;right:max(var(--margin),env(safe-area-inset-right,0px));bottom:3svh;font-variant-numeric:tabular-nums}

  /* —— bloques —— */
  .col-a{grid-column:1/8}
  .col-b{grid-column:9/-1;display:grid;gap:1em;align-content:start;padding-top:.4em}
  .services{grid-column:1/-1;list-style:none;margin:0;padding:0}
  .services li{display:grid;grid-template-columns:3rem minmax(0,1fr) minmax(0,1.3fr);gap:var(--gutter);align-items:baseline;padding:16px 0;border-bottom:1px solid var(--line)}
  .services a{font:400 var(--s2)/1.2 var(--serif);text-decoration:none}
  .services .n,.steps .n{font:400 var(--s-1)/1 var(--sans);color:var(--ocre);font-variant-numeric:tabular-nums}
  .services .d{color:var(--muted)}
  .steps{grid-column:1/-1;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:var(--gutter)}
  .steps li{display:grid;gap:8px;align-content:start;border-top:1px solid var(--coal);padding-top:12px}
  .steps b{font:400 var(--s1)/1.2 var(--serif)}
  .steps span:last-child{font-size:.95rem;color:var(--muted)}
  .portrait{grid-column:1/4;aspect-ratio:4/5;background:var(--sand);display:grid;place-items:center}
  .who{grid-column:6/-1;display:grid;gap:14px;align-content:start;max-width:40rem}
  .contact-big{grid-column:1/-1;font:italic 300 var(--s5)/1.05 var(--serif);text-decoration:none;justify-self:start;border-bottom:1px solid var(--line)}
  .contact-big:hover{border-bottom-color:currentColor}
  @media (max-width:900px){.steps{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:28px}}
  @media (max-width:760px){
    .col-a,.col-b,.portrait,.who{grid-column:1/-1}
    .col-b,.who{margin-top:24px}
    .services li{grid-template-columns:2.2rem minmax(0,1fr)}
    .services .d{grid-column:2}
    .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
    .portrait{max-width:20rem}
  }
</style>

<script is:inline>
(function(){
  var html=document.documentElement,sec=document.getElementById('entrada'),track=document.getElementById('track'),bar=document.getElementById('progress'),count=document.getElementById('count');
  if(!sec)return;
  var tiles=[].slice.call(track.querySelectorAll('.tile')),max=0,ticking=false;
  function measure(){
    if(!html.classList.contains('hscroll')){sec.style.height='';track.style.transform='';return;}
    var w=0;[].forEach.call(track.querySelectorAll('.row'),function(r){w=Math.max(w,r.scrollWidth)});
    max=Math.max(0,w-window.innerWidth);sec.style.height=(window.innerHeight+max)+'px';update();
  }
  function update(){ticking=false;if(!html.classList.contains('hscroll'))return;
    var r=sec.getBoundingClientRect(),span=sec.offsetHeight-window.innerHeight,p=span>0?Math.min(1,Math.max(0,-r.top/span)):0;
    track.style.transform='translate3d('+(-p*max).toFixed(1)+'px,0,0)';bar.style.transform='scaleX('+p.toFixed(4)+')';
    var vis=0,mid=window.innerWidth*.5;tiles.forEach(function(t,i){if(t.getBoundingClientRect().left<mid)vis=i});
    count.textContent=String(Math.min(tiles.length,vis+1)).padStart(2,'0');}
  window.addEventListener('scroll',function(){if(!ticking){ticking=true;requestAnimationFrame(update)}},{passive:true});
  /* con teclado: al llegar a un proyecto fuera de pantalla, se desplaza hasta él */
  track.addEventListener('focusin',function(e){if(!html.classList.contains('hscroll')||!max)return;var t=e.target.closest('a');if(!t)return;
    var x=t.offsetLeft+t.closest('.row').offsetLeft-window.innerWidth*.3,p=Math.min(1,Math.max(0,x/max));window.scrollTo({top:sec.offsetTop+p*(sec.offsetHeight-window.innerHeight),behavior:'auto'});});
  var mq=window.matchMedia('(min-width: 761px)'),rm=window.matchMedia('(prefers-reduced-motion: reduce)');
  function mode(){html.classList.toggle('hscroll',mq.matches&&!rm.matches);measure()}
  mq.addEventListener('change',mode);rm.addEventListener('change',mode);window.addEventListener('resize',measure);
  window.addEventListener('load',measure);if(document.fonts)document.fonts.ready.then(measure);measure();
})();
</script>
