---
import Base from '../../../layouts/Base.astro';
import Columnas from '../../../components/Columnas.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---
<Base title="Prototipo A · Columnas · Carballo Tardío" description="Prototipo: cuatro columnas de proyectos que suben y bajan con el scroll." current="proyectos">
  <p class="wrap meta" style="padding-bottom:12px">Prototipo A · Columnas. En este prototipo los proyectos se repiten para que haya recorrido.</p>
  <Columnas items={all} repetir />
</Base>
