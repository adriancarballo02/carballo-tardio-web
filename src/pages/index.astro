---
import Base from '../layouts/Base.astro';
import Seleccion from '../components/Seleccion.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SERVICIOS } from '../data/servicios';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const hero = all.find((p) => p.data.heroe) ?? all[0];
const sel = all.filter((p) => p.data.destacado && p !== hero).slice(0, 9);
---
<Base over title="Carballo Tardío · Estudio de creación y producción audiovisual" description="Estudio autoral de creación y producción audiovisual nacido en Peque, La Carballeda (Zamora). Vídeo, fotografía, dron, cine y dirección creativa.">
  <section class="hero" aria-label="Carballo Tardío">
    <Picture src={hero.data.portada} formats={['avif','webp']} widths={[800, 1400, 2000, 2600]} sizes="100vw" alt={`${hero.data.titulo}, ${hero.data.año}`} loading="eager" fetchpriority="high" class="hero-img" />
    <div class="shade" aria-hidden="true"></div>
    {hero.data.provisional && <span class="flag"><span class="prov">Imagen provisional</span></span>}
    <div class="hero-text wrap">
      <div class="claim">
        <h1>Una mirada propia para cada historia.</h1>
        <p>Estudio de creación y producción audiovisual. Desde Peque, La Carballeda. Trabajamos allí donde surgen los proyectos.</p>
        <a class="link" href="#seleccion">Ver proyectos ↓</a>
      </div>
      <a class="credit" href={`${base}proyectos/${hero.id}/`}><b>{hero.data.titulo}</b><span>{hero.data.año} · Ver proyecto</span></a>
    </div>
  </section>

  <section class="wrap seleccion" id="seleccion" aria-labelledby="sel-t">
    <div class="block-head"><h2 class="label" id="sel-t">Selección</h2><a class="meta" href={`${base}proyectos/`}>Archivo completo →</a></div>
    <Seleccion items={sel} />
  </section>

  <section class="block wrap grid">
    <div class="block-head"><h2 class="label">Estudio</h2><a class="meta" href={`${base}estudio/`}>Estudio →</a></div>
    <p class="lede col-a">Escuchamos antes de encender la cámara. Buscamos qué merece la pena contar y qué lenguaje necesita cada proyecto, ya sea una película propia, una campaña o el vídeo de un pequeño negocio. <em>No queremos trabajar más despacio. Queremos trabajar con intención.</em></p>
    <div class="col-b">
      <p class="label">Servicios</p>
      <ul class="svc">{SERVICIOS.map((s) => <li><a href={`${base}servicios/#${s.slug}`}>{s.nombre}</a></li>)}</ul>
      <p class="label">Quién</p>
      <p>Carballo Tardío es el estudio de Adrián Lozano Mateos, cineasta, guionista y escritor, que forma con colaboradores el equipo que necesita cada proyecto.</p>
    </div>
  </section>

  <section class="block wrap grid">
    <div class="block-head"><h2 class="label">Contacto</h2></div>
    <a class="contact-big" href={`${base}contacto/`}>Cuéntanos qué quieres contar.</a>
  </section>
</Base>

<style>
  .hero{position:relative;height:clamp(480px,88svh,960px);color:#F3E7CF;display:flex;align-items:flex-end;isolation:isolate;overflow:hidden;background:var(--coal)}
  .hero :global(.hero-img),.hero :global(picture){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
  .shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(20,17,14,.5),rgba(20,17,14,0) 26%,rgba(20,17,14,0) 52%,rgba(20,17,14,.62))}
  .flag{position:absolute;top:96px;right:max(var(--margin),env(safe-area-inset-right,0px))}
  .flag .prov{color:#F3E7CF;border-color:rgba(243,231,207,.6)}
  .hero-text{width:100%;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding-bottom:clamp(24px,4vw,48px)}
  .claim{display:grid;gap:14px;max-width:34rem}
  .claim h1{font:300 var(--s4)/1.08 var(--serif);letter-spacing:-.01em}
  .claim p{font:400 1rem/1.5 var(--sans);opacity:.92;max-width:30rem}
  .claim .link{justify-self:start;color:#F3E7CF}
  .credit{display:grid;text-align:right;text-decoration:none;font:400 .85rem/1.4 var(--sans);color:#F3E7CF}
  .credit b{font:italic 400 1.05rem/1.3 var(--serif)}
  .credit:hover{color:#fff}
  .seleccion{padding-top:clamp(40px,6vw,80px)}
  .col-a{grid-column:1/8}
  .col-b{grid-column:9/-1;display:grid;gap:10px;align-content:start;padding-top:.4em}
  .col-b .label:not(:first-child){margin-top:18px}
  .svc{list-style:none;margin:0;padding:0;font:400 var(--s1)/1.4 var(--serif)}
  .svc a{text-decoration:none}
  .contact-big{grid-column:1/-1;font:italic 300 var(--s5)/1.05 var(--serif);text-decoration:none;justify-self:start;border-bottom:1px solid var(--line)}
  .contact-big:hover{border-bottom-color:currentColor}
  @media (max-width:760px){
    .hero-text{flex-direction:column;align-items:flex-start}
    .credit{text-align:left}
    .col-a,.col-b{grid-column:1/-1}
    .col-b{margin-top:28px}
    .flag{top:auto;bottom:auto;top:120px}
  }
</style>
