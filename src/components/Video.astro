---
// Vídeo ligero: muestra la imagen de portada y no carga Vimeo/YouTube hasta que se pulsa.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { url: string; poster: ImageMetadata; titulo: string }
const { url, poster, titulo } = Astro.props;
let embed = '';
const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{6,})/);
const vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/(\w+))?/);
if (yt) embed = `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0`;
else if (vm) embed = `https://player.vimeo.com/video/${vm[1]}?autoplay=1${vm[2] ? `&h=${vm[2]}` : ''}&dnt=1`;
---
<div class="video" data-embed={embed}>
  <Picture src={poster} formats={['avif','webp']} widths={[800, 1400, 2000]} sizes="100vw" alt="" loading="eager" />
  {embed ? <button type="button" class="play" aria-label={`Reproducir ${titulo}`}><span aria-hidden="true">▶</span> Reproducir</button> : <a class="play" href={url}>Ver vídeo</a>}
</div>
<style>
  .video{position:relative;aspect-ratio:16/9;background:var(--coal);overflow:hidden}
  .video :global(picture),.video :global(img){width:100%;height:100%;object-fit:cover}
  .video :global(iframe){position:absolute;inset:0;width:100%;height:100%;border:0}
  .play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font:500 1rem/1 var(--sans);color:var(--paper);background:rgba(48,43,37,.72);border:1px solid rgba(240,232,217,.5);padding:14px 20px;border-radius:999px;cursor:pointer;text-decoration:none}
  .play:hover{background:rgba(48,43,37,.9);color:#fff}
</style>
<script is:inline>
document.querySelectorAll('.video[data-embed]').forEach(function(v){var b=v.querySelector('button.play');if(!b)return;b.addEventListener('click',function(){
  var f=document.createElement('iframe');f.src=v.dataset.embed;f.allow='autoplay; fullscreen; picture-in-picture';f.allowFullscreen=true;f.title=b.getAttribute('aria-label').replace('Reproducir ','');v.appendChild(f);b.remove();f.focus();});});
</script>
